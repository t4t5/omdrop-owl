#!/usr/bin/env bash
# omdrop-discoverable for OWL: the radio half of omdrop on cards without
# Apple's Broadcom firmware (first target: MediaTek MT7925), where AWDL runs in
# userspace through OWL on a monitor interface.
#
#   omdrop-discoverable start <seconds>    become discoverable for N seconds (0: until stopped)
#   omdrop-discoverable stop               stop advertising, tear down
#   omdrop-discoverable status [--json]    {"visible":bool,"remaining":int|null,"reason":str,"rx_proven":bool,"peer_op":str}
#   omdrop-discoverable peers              "<mac> rssi=?" per AWDL peer
#   omdrop-discoverable probe --json       what this backend is and what blocks it
#                                          (unprivileged; omdrop's docs/radio-backend.md)
#
# The same contract as omdrop-awdl's helper, which the omdrop CLI and
# send-to-peer call against. Exit codes:
#   0  visible (start), stopped (stop), always (status, peers)
#   2  usage error, or not root
#   3  can't become discoverable now (Wi-Fi not connected, or its AP isn't on
#      an AWDL channel); retryable
#   4  no AWDL radio (no suitable Wi-Fi interface, or awdl0 never came up)
#   5  already discoverable; the window was extended instead
#
# How (README, "How it works"): the station stays associated, and AWDL runs
# on the AP's own channel, which must be 6, 44 or 149. A monitor vif carries the station's MAC; OWL runs on it with -S
# intersect, so it only advertises the phone's slots on that channel; the
# station vif ACKs the phone's unicast. OWL creates awdl0, which omdrop's
# receiver binds to; omdrop-awdl's awdl-airdrop-adv.py announces _airdrop._tcp
# on it (--plain: OWL adds the AWDL encapsulation itself).
#
# A card whose profile says "exclusive" can't do that (Intel). Its station
# comes down for the window, and an ad-hoc vif on AWDL's own BSSID sits beside
# the monitor vif on a channel the card may transmit on: see exclusive_up.
#
# ROOT: required. Callers come through pkexec, which drops the environment, so
# everything lives at fixed paths: helpers beside this script (/usr/lib/omdrop
# when packaged), state in $RUN, tunables in $CONF.
set -uo pipefail

SELF=$(readlink -f "$0")
LIB=$(dirname "$SELF")
RUN=/run/omdrop-owl
CONF=${OMDROP_CONF:-/etc/omdrop}
OWL_LOG=$RUN/owl.log
IF=awdl0
MON=mon0
IBSS=awdlibss0
AWDL_BSSID=00:25:00:ff:94:73
OWL_BIN=$LIB/owl
PROFILES=$LIB/owl-profiles
# Receiver capability flags in the announcement, as omdrop-awdl sends them:
# 0x88 (OpenDrop's: SUPPORTS_MIXED_TYPES | SUPPORTS_DISCOVER_MAYBE) + SUPPORTS_URL.
ADV_FLAGS=137
ADV_INTERVAL=3
# One round of announcements. Three copies do in shared mode, where OWL sends
# them in AWDL's multicast slots and the phone is on our channel for those. In
# exclusive mode it visits our channel for a slot or two in sixteen, and OWL
# sends multicast as it comes (owl -F): a copy every 16 TU, one availability
# window, for a whole period of sixteen slots.
ADV_BURST="--count 3 --interval 0.05"
ADV_BURST_EXCLUSIVE="--count 64 --interval 0.0164"
VERSION=0.1.0
# The omdrop-awdl helper contract this follows, which is also the version of
# omdrop-awdl's tools staged beside it.
CONTRACT=0.8.1

# status and peers run without root, so logging must fail quietly.
log() { { mkdir -p "$RUN" && printf '%s %s\n' "$(date -u +%H:%M:%SZ)" "$*" >> "$RUN/log"; } 2>/dev/null || true; }
die() { log "error: $1"; echo "omdrop-discoverable: $1" >&2; exit "${2:-2}"; }
knob() { head -1 "$CONF/$1" 2>/dev/null | tr -d '[:space:]' || true; }
# Through /proc, not kill -0: omdrop runs `status` without root, and an
# unprivileged kill -0 on these root-owned processes fails with EPERM, which
# read as "not running" and left the panel on "Waking the radio" for a whole
# window. The command line has to match too, so a recycled pid doesn't pass.
alive() {  # PID [PATTERN]
  [ -n "$1" ] && [ -r "/proc/$1/cmdline" ] \
    && { [ -z "${2:-}" ] || tr '\0' ' ' < "/proc/$1/cmdline" | grep -qF -- "$2"; }
}
pid_of() { cat "$RUN/$1.pid" 2>/dev/null; }
need_root() { [ "$(id -u)" = 0 ] || die "must run as root (through pkexec)" 2; }

# The Wi-Fi station: $CONF/infra-iface, else the first managed interface.
station_iface() {
  local forced d name
  forced=$(knob infra-iface)
  [ -n "$forced" ] && { echo "$forced"; return; }
  for d in /sys/class/net/*/phy80211; do
    name=$(basename "$(dirname "$d")")
    [ "$name" = "$IF" ] || [ "$name" = "$MON" ] || [ "$name" = "$IBSS" ] && continue
    iw dev "$name" info 2>/dev/null | grep -q 'type managed' || continue
    echo "$name"
    return
  done
}

driver_of() { basename "$(readlink -f "/sys/class/net/$1/device/driver")" 2>/dev/null; }

# This driver's line in owl-profiles, else the "*" line: sets PROF_STATUS,
# PROF_MODE, PROF_MONMAC, PROF_RECONNECT and PROF_PM (see owl-profiles).
# $CONF/owl-profiles, when present, is read first: it's where to try settings
# for a new card without editing the packaged table.
load_profile() {  # DRIVER
  local line _ tables=()
  [ -r "$CONF/owl-profiles" ] && tables+=("$CONF/owl-profiles")
  [ -r "$PROFILES" ] && tables+=("$PROFILES")
  [ ${#tables[@]} -gt 0 ] || return 1
  line=$(awk -v d="$1" '!/^#/ && NF >= 6 && $1 == d {print; exit}' "${tables[@]}")
  [ -n "$line" ] || line=$(awk '!/^#/ && NF >= 6 && $1 == "*" {print; exit}' "${tables[@]}")
  [ -n "$line" ] || return 1
  read -r _ PROF_STATUS PROF_MODE PROF_MONMAC PROF_RECONNECT PROF_PM _ <<< "$line"
}

untested_hint() {
  echo "omdrop-owl hasn't been tested on this computer's Wi-Fi (${1:-unknown driver}). To try it anyway, put 1 in $CONF/allow-untested, and please report how it goes (README, \"Adding your card\")."
}

mt76_dir() { echo "/sys/kernel/debug/ieee80211/$(basename "$(readlink -f "/sys/class/net/$1/phy80211")")/mt76"; }

# ------------------------------------------------------------- exclusive mode

# AWDL's channels this card may transmit on, 5 GHz first: an iPhone gives
# channel 6 a slot or two in sixteen and 44 or 149 several. One marked "No IR",
# radar or disabled is receive-only. That a channel is allowed doesn't mean an
# ad-hoc cell can start there: the AX201 refuses every 5 GHz one (EINVAL on
# 149 under a GB regdomain, where 44 is "No IR" until it has an AP there), so
# exclusive_up tries them in this order.
tx_channels() {  # PHY
  local ok c
  ok=$(iw phy "$1" channels 2>/dev/null | awk '
    /^[[:space:]]*\* [0-9]+ MHz/ { if (f && ok) print f; f = $2; ok = !/disabled/; next }
    /No IR|Radar detection/ { ok = 0 }
    END { if (f && ok) print f }')
  for c in 5220 5745 2437; do
    grep -qx "$c" <<< "$ok" && echo "$c"
  done
}

# Take the station off the air and put an ad-hoc vif in its place. AWDL's
# frames are IBSS frames with a fixed BSSID, so joining that "IBSS" gives the
# firmware an address to ACK for and a BSSID filter that passes AWDL, and
# mac80211 a station entry per peer: unicast is sent, retried and ACKed the
# ordinary way. Injected frames carry this vif's MAC, which is how mac80211
# picks the vif to send them through. A monitor vif alone on the AX201 never
# sees an ACK, and spends 100 ms retrying every unicast frame.
# The cell has to be HT. An iPhone sends its unicast at HT rates (MCS 7 at
# 65 Mbit/s here), which a NOHT cell neither receives nor ACKs; the phone then
# takes us for unreachable and doesn't try again until it restarts.
# The cell beacons as rarely as it may (every 10000 TU). Its beacons carry
# AWDL's BSSID, which no AWDL device beacons with, and an iPhone restarted
# beside a cell beaconing every 100 TU didn't list us where one beside a cell
# beaconing every 10 s did (once each).
# NetworkManager has to let go of the station first, or it brings it straight
# back; $RUN/exclusive tells `stop` to give it back.
# Prints the frequency the cell started on.
exclusive_up() {  # STA PHY FREQ...
  local sta=$1 phy=$2 f
  shift 2
  echo "$sta" > "$RUN/exclusive"
  nmcli device set "$sta" managed no >/dev/null 2>&1
  ip link set "$sta" down
  iw dev "$IBSS" del 2>/dev/null
  iw phy "$phy" interface add "$IBSS" type ibss || return 1
  ip link set "$IBSS" address "$(cat "/sys/class/net/$sta/address")"
  # IP runs on awdl0. Left alone, the kernel and avahi take this vif for a
  # network too and send plain IPv6 on AWDL's BSSID.
  sysctl -qw "net.ipv6.conf.$IBSS.disable_ipv6=1" 2>/dev/null
  ip link set "$IBSS" up || return 1
  for f in "$@"; do
    iw dev "$IBSS" ibss join omdrop "$f" HT20 fixed-freq "$AWDL_BSSID" beacon-interval 10000 >&2 || continue
    # mac80211 scans the channel once before it starts the cell.
    for _ in $(seq 40); do
      iw dev "$IBSS" link 2>/dev/null | grep -q '^Joined IBSS' && { echo "$f"; return 0; }
      sleep 0.25
    done
    iw dev "$IBSS" ibss leave 2>/dev/null
  done
  return 1
}

# NetworkManager reconnects by itself once it has the station back.
exclusive_down() {
  local sta
  iw dev "$IBSS" ibss leave 2>/dev/null
  iw dev "$IBSS" del 2>/dev/null
  sta=$(cat "$RUN/exclusive" 2>/dev/null)
  [ -n "$sta" ] || return 0
  ip link set "$sta" up 2>/dev/null
  nmcli device set "$sta" managed yes >/dev/null 2>&1
  rm -f "$RUN/exclusive"
}

# --------------------------------------------------------------------- status

visible() {
  alive "$(pid_of supervisor)" __supervise && alive "$(pid_of owl)" "$OWL_BIN" \
    && ip -6 addr show dev "$IF" scope link 2>/dev/null | grep -q inet6 \
    && ! ip -6 addr show dev "$IF" scope link | grep -q tentative
}

cmd_status() {
  local vis=false remaining=null reason until rx=false now
  reason=$(cat "$RUN/reason" 2>/dev/null)
  if visible; then
    vis=true
    until=$(cat "$RUN/until" 2>/dev/null || echo 0)
    now=$(date +%s)
    [ "${until:-0}" -gt 0 ] && remaining=$(( until > now ? until - now : 0 ))
  fi
  # OWL synced with at least one peer in this window: receive proven, not just
  # transmit. The log outlives a window, so only while one is up.
  [ "$vis" = true ] && grep -q 'add peer' "$OWL_LOG" 2>/dev/null && rx=true
  if [ "${1:-}" = --json ]; then
    printf '{"visible":%s,"remaining":%s,"reason":"%s","rx_proven":%s,"peer_op":""}\n' \
      "$vis" "$remaining" "${reason//\"/}" "$rx"
  else
    printf 'visible=%s remaining=%s reason=%s rx_proven=%s\n' "$vis" "$remaining" "${reason:-}" "$rx"
  fi
}

# ---------------------------------------------------------------------- peers

# OWL logs "add peer <mac> (<name>)" and "remove peer <mac> (<name>)" at INFO,
# with ether_ntoa's unpadded octets (86:8:4:8a:2b:f4), and adds each peer as a
# permanent IPv6 neighbour on awdl0, which send-to-peer merges in as well. The
# signal strength is only in OWL's TRACE output, so it is reported as unknown;
# send-to-peer and the omdrop CLI both list such peers as "? dBm". iPhones
# randomise their AWDL address, so nothing here remembers one.
cmd_peers() {
  [ -r "$OWL_LOG" ] || die "no OWL log at $OWL_LOG; is the radio up?" 4
  grep -oE '(add|remove) peer [0-9a-f:]+' "$OWL_LOG" | awk '
    { n = split($3, o, ":"); mac = ""
      for (i = 1; i <= n; i++) mac = mac (i > 1 ? ":" : "") sprintf("%02s", o[i])
      gsub(/ /, "0", mac)
      if ($1 == "add") seen[mac] = 1; else delete seen[mac] }
    END { for (m in seen) print m " rssi=?" }'
}

# ---------------------------------------------------------------------- probe

# What omdrop's doctor shows: the backend, and what stands in the way, most
# fundamental first. Unprivileged, so nothing here may need root.
cmd_probe() {
  local sta drv hw=true ap missing=()
  sta=$(station_iface)
  drv=$( [ -n "$sta" ] && driver_of "$sta" )
  if [ -z "$sta" ]; then
    hw=false
    missing+=("hardware|This computer has no Wi-Fi interface that omdrop-owl can use.")
  elif ! load_profile "$drv"; then
    hw=false
    missing+=("backend|omdrop-owl is installed without its hardware profiles ($PROFILES). Reinstall omdrop-owl.")
  elif [ "$PROF_STATUS" != tested ] && [ "$(knob allow-untested)" != 1 ]; then
    hw=false
    missing+=("hardware|$(untested_hint "$drv")")
  else
    [ -x "$OWL_BIN" ] || missing+=("backend|omdrop-owl is installed without OWL ($OWL_BIN). Reinstall omdrop-owl.")
    [ "$PROF_MODE" = shared ] || [ "$PROF_MODE" = exclusive ] || missing+=("backend|This Wi-Fi card's profile asks for \"$PROF_MODE\" mode, which omdrop-owl doesn't implement yet.")
    ap=$(iw dev "$sta" link 2>/dev/null | awk '/freq:/ {print int($2)}')
    case "$PROF_MODE:$ap" in
      exclusive:*|*:2437|*:5220|*:5745) ;;
      *:) missing+=("radio|Wi-Fi isn't connected, and AirDrop shares its channel. Connect to Wi-Fi first.") ;;
      *) missing+=("radio|Your Wi-Fi network is on $ap MHz, but AirDrop can only share channel 6, 44 or 149 with it. Moving the router to one of those makes this work.") ;;
    esac
  fi
  [ "${1:-}" = --json ] || { printf '%s\n' "${missing[@]:-ready}"; return 0; }
  MISSING=$(printf '%s\n' "${missing[@]}") HW=$hw V=$VERSION C=$CONTRACT python3 -c '
import json, os
rows = [l.split("|", 1) for l in os.environ["MISSING"].split("\n") if l.strip()]
print(json.dumps({"backend": "owl", "version": os.environ["V"], "contract": os.environ["C"],
                  "hardware": os.environ["HW"] == "true",
                  "missing": [{"id": r[0], "say": r[1]} for r in rows]}))'
}

# ----------------------------------------------------------------------- stop

cmd_stop() {
  local why=${1:-stopped} sup sta pm reconnect
  need_root
  exec 9> "$RUN/lock" 2>/dev/null || { mkdir -p "$RUN"; exec 9> "$RUN/lock"; }
  flock 9
  sup=$(pid_of supervisor)
  # The supervisor calls `stop expired` itself; don't kill the caller.
  [ -n "$sup" ] && [ "$sup" != "$$" ] && [ "$sup" != "${PPID:-}" ] && kill "$sup" 2>/dev/null
  pkill -f -- "$LIB/awdl-airdrop-adv.py" 2>/dev/null
  alive "$(pid_of owl)" "$OWL_BIN" && kill "$(pid_of owl)" 2>/dev/null
  pkill -f "^$OWL_BIN " 2>/dev/null
  ip link set "$MON" down 2>/dev/null
  iw dev "$MON" del 2>/dev/null
  exclusive_down
  sta=$(cat "$RUN/station" 2>/dev/null)
  pm=$(cat "$RUN/pm" 2>/dev/null)
  if [ -n "$sta" ] && [ -n "$pm" ]; then
    echo "${pm%% *}" > "$(mt76_dir "$sta")/runtime-pm" 2>/dev/null
    echo "${pm##* }" > "$(mt76_dir "$sta")/deep-sleep" 2>/dev/null
  fi
  # Some drivers' stations stop receiving after a monitor vif is deleted (the
  # MT7925: README, "Known issues"), and omdrop's contract forbids reloading
  # the driver here. A fresh association right after the delete has kept it
  # healthy in every teardown tested, so force one where the profile says so.
  # $CONF/reconnect-after (0 or 1) overrides the profile.
  reconnect=$(knob reconnect-after)
  case "$reconnect" in
    0) reconnect=no ;;
    1) reconnect=yes ;;
    *) reconnect=$(awk '{print $4}' "$RUN/profile" 2>/dev/null) ;;
  esac
  if [ -n "$sta" ] && [ "$reconnect" = yes ]; then
    sleep 1
    nmcli -w 20 device connect "$sta" >/dev/null 2>&1 || iw dev "$sta" disconnect 2>/dev/null
  fi
  rm -f "$RUN/supervisor.pid" "$RUN/owl.pid" "$RUN/until"
  printf '%s' "$why" > "$RUN/reason"
  log "stopped ($why)"
  return 0
}

# ---------------------------------------------------------------------- start

# The background half of a window: announce, watch OWL, end at expiry.
supervise() {
  local until burst=$ADV_BURST
  [ -e "$RUN/exclusive" ] && burst=$ADV_BURST_EXCLUSIVE
  while true; do
    until=$(cat "$RUN/until" 2>/dev/null || echo 0)
    if [ "${until:-0}" -gt 0 ] && [ "$(date +%s)" -ge "$until" ]; then
      log "window expired"
      exec "$SELF" stop expired
    fi
    if ! alive "$(pid_of owl)" "$OWL_BIN"; then
      log "OWL exited: $(tail -1 "$OWL_LOG" 2>/dev/null)"
      exec "$SELF" stop owl-exited
    fi
    python3 "$LIB/awdl-airdrop-adv.py" --iface "$IF" --plain --flags "$ADV_FLAGS" --port 8771 \
      $burst >> "$RUN/announce.log" 2>&1
    sleep "$ADV_INTERVAL"
  done
}

cmd_start() {
  local secs=${1:-} sta drv phy gw ap freqs chan stamac monmac mt76 _
  local owl_extra=() strategy=intersect
  [[ "$secs" =~ ^[0-9]+$ ]] || die "usage: omdrop-discoverable start <seconds>" 2
  need_root
  mkdir -p "$RUN"
  exec 9> "$RUN/lock"
  flock 9
  [ -x "$OWL_BIN" ] || die "OWL is not installed at $OWL_BIN" 4

  if alive "$(pid_of supervisor)" __supervise; then
    if [ "$secs" -gt 0 ]; then echo $(( $(date +%s) + secs )) > "$RUN/until"; else echo 0 > "$RUN/until"; fi
    log "already discoverable; window now ${secs}s"
    exit 5
  fi
  : > "$RUN/log"
  : > "$RUN/announce.log"
  rm -f "$RUN/reason"

  sta=$(station_iface)
  [ -n "$sta" ] || die "no Wi-Fi interface to run AWDL on" 4
  drv=$(driver_of "$sta")
  load_profile "$drv" || die "no hardware profile at $PROFILES; reinstall omdrop-owl" 4
  if [ "$PROF_STATUS" != tested ] && [ "$(knob allow-untested)" != 1 ]; then
    die "$(untested_hint "$drv")" 4
  fi
  [ "$PROF_MODE" = shared ] || [ "$PROF_MODE" = exclusive ] || die "this Wi-Fi card's profile asks for \"$PROF_MODE\" mode, which omdrop-owl doesn't implement yet" 4
  phy=$(basename "$(readlink -f "/sys/class/net/$sta/phy80211")")
  if [ "$PROF_MODE" = exclusive ]; then
    gw=none
    freqs=$(tx_channels "$phy")
    [ -n "$freqs" ] || die "this Wi-Fi card may not transmit on any of AirDrop's channels (6, 44, 149) here" 4
    # From here a failure has to give Wi-Fi back, which is cmd_stop's job.
    if ! ap=$(exclusive_up "$sta" "$phy" $freqs); then
      cmd_stop start-failed >/dev/null
      die "could not start the ad-hoc interface $IBSS on any of AirDrop's channels" 4
    fi
  else
    # Wi-Fi takes a few seconds after a driver reload to associate and get an
    # address; don't judge a link that's still coming up.
    for _ in $(seq 15); do
      gw=$(ip -4 route show default dev "$sta" 2>/dev/null | awk '{print $3; exit}')
      [ -n "$gw" ] && ping -c1 -W1 -I "$sta" "$gw" >/dev/null 2>&1 && break
      gw=""
      sleep 1
    done
    [ -n "$gw" ] || die "Wi-Fi isn't connected (or isn't passing traffic), and AirDrop shares its channel. Connect to Wi-Fi and try again." 3
    ap=$(iw dev "$sta" link | awk '/freq:/ {print int($2)}')
  fi
  case "$ap" in
    2437) chan=6 ;; 5220) chan=44 ;; 5745) chan=149 ;;
    *) die "your Wi-Fi network is on ${ap:-an unknown} MHz, but AirDrop can only share channel 6, 44 or 149 with it. Moving the router to one of those makes this work." 3 ;;
  esac
  stamac=$(cat "/sys/class/net/$sta/address")
  echo "$sta" > "$RUN/station"
  echo "$drv $PROF_MODE $PROF_MONMAC $PROF_RECONNECT $PROF_PM" > "$RUN/profile"
  log "station $sta ($stamac, $drv) on ch$chan, gateway $gw; profile: mode=$PROF_MODE mon_mac=$PROF_MONMAC reconnect=$PROF_RECONNECT mt76_pm=$PROF_PM"

  iw dev "$MON" del 2>/dev/null
  if ! iw phy "$phy" interface add "$MON" type monitor; then
    cmd_stop start-failed >/dev/null
    die "could not create the monitor interface $MON" 4
  fi
  # mon_mac: the station's MAC on the monitor interface, or one of its own
  # (locally administered, derived from the station's) with OWL told the
  # station's through -m.
  if [ "$PROF_MONMAC" = own ]; then
    monmac="02:${stamac#*:}"
    owl_extra=(-m "$stamac")
  else
    monmac=$stamac
  fi
  ip link set "$MON" address "$monmac"
  if ! ip link set "$MON" up; then
    cmd_stop start-failed >/dev/null
    die "could not bring $MON up" 4
  fi
  # owl -F, -E: patches/owl-03-fixed-radio.patch, owl-04-election-metric.patch.
  # -S pin advertises our one channel in all sixteen slots, which with -F is
  # where we are (patches/owl-06-fixed-radio-pin.patch), rather than only the
  # slots the phone already gives it: those move while the phone makes room
  # for us, and the intersection trails them by a tick.
  if [ "$PROF_MODE" = exclusive ]; then
    owl_extra+=(-F -E)
    strategy=pin
  fi

  # mt76_pm: runtime PM off for the window, restored by stop.
  mountpoint -q /sys/kernel/debug || mount -t debugfs none /sys/kernel/debug 2>/dev/null
  mt76=$(mt76_dir "$sta")
  if [ "$PROF_PM" = yes ] && [ -w "$mt76/runtime-pm" ]; then
    echo "$(cat "$mt76/runtime-pm") $(cat "$mt76/deep-sleep")" > "$RUN/pm"
    echo 0 > "$mt76/runtime-pm"
    echo 0 > "$mt76/deep-sleep"
  fi

  if [ "$secs" -gt 0 ]; then echo $(( $(date +%s) + secs )) > "$RUN/until"; else echo 0 > "$RUN/until"; fi
  # 9>&-: children must not inherit the lock, or the long-lived ones would hold
  # it for the whole window and the next `stop` would wait forever.
  setsid "$OWL_BIN" -i "$MON" -c "$chan" -N -S "$strategy" "${owl_extra[@]}" -v > "$OWL_LOG" 2>&1 < /dev/null 9>&- &
  echo $! > "$RUN/owl.pid"
  for _ in $(seq 20); do ip link show "$IF" >/dev/null 2>&1 && break; sleep 0.5; done
  if ! ip link show "$IF" >/dev/null 2>&1; then
    local why; why=$(tail -1 "$OWL_LOG" 2>/dev/null)
    cmd_stop owl-failed >/dev/null
    die "AWDL didn't come up: ${why:-OWL exited}" 4
  fi
  nmcli device set "$IF" managed no >/dev/null 2>&1
  ip link set "$IF" up
  # awdl0's link-local stays "tentative" during duplicate address detection,
  # and omdrop's receiver refuses to start without a usable one.
  for _ in $(seq 20); do
    ip -6 addr show dev "$IF" scope link | grep -q inet6 \
      && ! ip -6 addr show dev "$IF" scope link | grep -q tentative && break
    sleep 0.5
  done

  setsid "$SELF" __supervise > /dev/null 2>&1 < /dev/null 9>&- &
  echo $! > "$RUN/supervisor.pid"
  log "discoverable for ${secs}s (0 = until stopped)"
  return 0
}

case "${1:-}" in
  start)  shift; cmd_start "$@" ;;
  stop)   cmd_stop "${2:-stopped}" ;;
  status) shift; cmd_status "$@" ;;
  peers)  cmd_peers ;;
  probe)  shift; cmd_probe "$@" ;;
  __supervise) supervise ;;
  *) die "usage: omdrop-discoverable start <seconds> | stop | status [--json] | peers | probe [--json]" 2 ;;
esac
