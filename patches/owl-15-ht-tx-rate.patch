diff --git a/src/tx.c b/src/tx.c
index eb3fb0c..d640ec9 100644
--- a/src/tx.c
+++ b/src/tx.c
@@ -333,19 +333,26 @@ struct ieee80211_tx_rate awdl_data_tx_rate = { .legacy = 12, .mcs = -1, .sgi = 0
 
 static const struct ieee80211_tx_rate legacy_12 = { .legacy = 12, .mcs = -1, .sgi = 0 };
 
-/* "12" (legacy Mbit/s), "mcs7" (HT MCS, 20 MHz) or "mcs7-sgi". */
+/* mcsN is 20 MHz, long GI, as before; -20/-40 and -lgi/-sgi say otherwise. */
 int ieee80211_parse_tx_rate(const char *s, struct ieee80211_tx_rate *rate) {
 	static const int legacy_ok[] = { 6, 9, 12, 18, 24, 36, 48, 54 };
 	char *end;
 	long v;
 
 	rate->sgi = 0;
+	rate->bw40 = 0;
 	if (!strncmp(s, "mcs", 3)) {
 		v = strtol(s + 3, &end, 10);
 		if (end == s + 3 || v < 0 || v > 15)
 			return -1;
+		if (!strncmp(end, "-20", 3) || !strncmp(end, "-40", 3)) {
+			rate->bw40 = end[1] == '4';
+			end += 3;
+		}
 		if (!strcmp(end, "-sgi"))
 			rate->sgi = 1;
+		else if (!strcmp(end, "-lgi"))
+			rate->sgi = 0;
 		else if (*end)
 			return -1;
 		rate->mcs = (int) v;
@@ -368,7 +375,8 @@ int ieee80211_parse_tx_rate(const char *s, struct ieee80211_tx_rate *rate) {
 int ieee80211_format_tx_rate(char *buf, size_t len, const struct ieee80211_tx_rate *rate) {
