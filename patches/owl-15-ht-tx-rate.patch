 		return snprintf(buf, len, "legacy %d Mbit/s", rate->legacy);
-	return snprintf(buf, len, "HT MCS %d, 20 MHz%s", rate->mcs, rate->sgi ? ", short GI" : "");
+	return snprintf(buf, len, "HT MCS %d, %d MHz, %s GI", rate->mcs,
+	                rate->bw40 ? 40 : 20, rate->sgi ? "short" : "long");
 }
 
