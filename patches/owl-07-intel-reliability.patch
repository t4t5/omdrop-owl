diff --git i/daemon/io.c w/daemon/io.c
index 9a1ebe1..87a0190 100644
--- i/daemon/io.c
+++ w/daemon/io.c
@@ -388,6 +388,13 @@ int wlan_send(const struct io_state *state, const uint8_t *buf, int len) {
 		return -EINVAL;
 	err = pcap_inject(state->wlan_handle, buf, len);
 	if (err < 0) {
+		/* The handle is non-blocking: EAGAIN means the driver queue is full
+		 * right now. Hand it back so a unicast caller can keep the frame and
+		 * try again from the event loop, instead of dropping it (2026-10-10:
+		 * 8383 drops in one 34 MB receive on an Intel card, among them the
+		 * TCP ACKs the phone needed, so uploads died just short of the end). */
+		if (errno == EAGAIN || errno == ENOBUFS)
+			return -EAGAIN;
 		log_error("unable to inject packet (%s)", pcap_geterr(state->wlan_handle));
 		return err;
 	}
diff --git i/src/peers.c w/src/peers.c
index 2202de8..b505cbc 100644
--- i/src/peers.c
+++ w/src/peers.c
@@ -29,7 +29,8 @@
  * documented. They are consumed as us by awdl_clean_peers() (cutoff against
  * clock_time_us()) and by usec_to_sec() when arming the cleanup timer.
  * Effective policy: evict peers unheard for 2 s, swept once per second. */
-#define PEERS_DEFAULT_TIMEOUT        2000000 /* in us (2 s) */
+/* 5 s, not 2: a busy iPhone can miss several of our slots in a row (2026-10-10). */
+#define PEERS_DEFAULT_TIMEOUT        5000000 /* in us (5 s) */
 #define PEERS_DEFAULT_CLEAN_INTERVAL 1000000 /* in us (1 s) */
 
 void awdl_peer_state_init(struct awdl_peer_state *state) {
diff --git i/src/rx.c w/src/rx.c
index 4581ae5..a15f343 100644
--- i/src/rx.c
+++ w/src/rx.c
@@ -374,8 +374,16 @@ int awdl_rx_data(const struct buf *frame, struct buf ***out, const struct ether_
 	log_trace("awdl_data: receive from %s", ether_ntoa(src));
 	state->stats.rx_data++;
 
-	if (awdl_peer_get(state->peers.peers, src, NULL) != PEERS_OK)
+	struct awdl_peer *peer;
+	if (awdl_peer_get(state->peers.peers, src, &peer) != PEERS_OK)
 		return RX_IGNORE_PEER;
+	/* Data from a peer proves it is still there. Only action frames used to
+	 * refresh it, and an iPhone deep in a transfer, visiting our channel for
+	 * one slot in sixteen, can go 2 s between the ones we hear: OWL then
+	 * dropped it mid-upload and threw away our ACKs to it ("Drop frame to
+	 * non-peer", 1405 in one 34 MB receive on 2026-10-10), the final ACK
+	 * among them, so the phone waited until the upload timed out. */
+	peer->last_update = clock_time_us();
 
 	if (!awdl_valid_llc_header(frame))
 		return RX_UNEXPECTED_FORMAT;
