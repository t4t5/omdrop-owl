diff --git a/src/tx.c b/src/tx.c
index 20b8326..eb3fb0c 100644
--- a/src/tx.c
+++ b/src/tx.c
@@ -239,9 +239,42 @@ int awdl_init_ht_capabilities_tlv(uint8_t *buf, const struct awdl_state *state _
 	tlv->unknown = htole16(0);
 	tlv->unknown2 = htole16(0);
 
+	if (awdl_wide) {
+		/* Two streams the way an iPad sends them: one more MCS byte, nine
+		 * bytes in all (00 00 ce 11 1b ff ff 00 00). Folding it into the
+		 * 8-byte form made Android's AWDL daemon reject our frames
+		 * ("Failed to deserialize HtCaps: 0000ce111bffff00"). */
+		uint8_t *v = buf + sizeof(struct tl);
+		static const uint8_t tail[] = { 0x1b, 0xff, 0xff, 0x00, 0x00 };
+		memcpy(v + 4, tail, sizeof(tail));
+		tlv->length = htole16(9);
+		return sizeof(struct tl) + 9;
+	}
 	return sizeof(struct awdl_ht_capabilities_tlv);
 }
 
+int awdl_wide = 0;
+
+/* An IEEE 802.11 container TLV carrying a VHT Capabilities element, laid out
+ * as an iPad sends it (bf 0c, caps, rx map, rx highest, tx map, tx highest).
+ * Caps: RX LDPC, short GI 80, RX STBC 1, max A-MPDU exponent 7; no
+ * beamforming, as an injecting monitor can't sound. Maps: 2 streams MCS 0-9,
+ * as `iw phy` reports for the MT7921. */
+int awdl_init_vht_capabilities_tlv(uint8_t *buf, const struct awdl_state *state __attribute__((unused))) {
+	static const uint8_t ie[] = {
+		191, 12,
+		0x30, 0x01, 0x80, 0x03, /* 0x03800130 */
+		0xfa, 0xff, 0x00, 0x00,
+		0xfa, 0xff, 0x00, 0x00,
+	};
+	struct tl *tlv = (struct tl *) buf;
+
+	tlv->type = AWDL_IEEE80211_CNTNR_TLV;
+	tlv->length = htole16(sizeof(ie));
+	memcpy(buf + sizeof(struct tl), ie, sizeof(ie));
+	return sizeof(struct tl) + sizeof(ie);
+}
+
 int awdl_init_data_path_state_tlv(uint8_t *buf, const struct awdl_state *state) {
 	struct awdl_data_path_state_tlv *tlv = (struct awdl_data_path_state_tlv *) buf;
 
@@ -484,6 +517,8 @@ int awdl_init_full_action_frame(uint8_t *buf, struct awdl_state *state, struct i
 	ptr += awdl_init_service_params_tlv(ptr, state);
 	if (type == AWDL_ACTION_MIF)
 		ptr += awdl_init_ht_capabilities_tlv(ptr, state);
+	if (type == AWDL_ACTION_MIF && awdl_wide)
+		ptr += awdl_init_vht_capabilities_tlv(ptr, state);
 	if (type == AWDL_ACTION_MIF)
 		ptr += awdl_init_arpa_tlv(ptr, state);
 	ptr += awdl_init_data_path_state_tlv(ptr, state);
