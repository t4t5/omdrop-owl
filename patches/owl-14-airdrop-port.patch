+/* AWDL shortens common DNS names to a two-byte code, 0xc000 + index, as in
+ * Wireshark's awdl_dns_compression. Android's Quick Share writes its AirDrop
+ * service names with them, mid-name. */
+static const char *const dns_codes[] = {
+	"", "_airplay._tcp.local", "_airplay._udp.local", "_airplay", "_raop._tcp.local",
+	"_raop._udp.local", "_raop", "_airdrop._tcp.local", "_airdrop._udp.local", "_airdrop",
+	"_tcp.local", "_udp.local", "local", "ip6.arpa", "ip4.arpa",
+};
+
+/* Expands the name in name[0..len) into out; its length, or -1 if it is
+ * malformed or does not fit. */
+static int dns_name(const uint8_t *name, int len, char *out, int size) {
+	int i = 0, n = 0;
+	while (i < len) {
+		const char *part;
+		int part_len;
+		if ((name[i] & 0xc0) == 0xc0) {
+			if (i + 2 > len || name[i] != 0xc0 || name[i + 1] >= sizeof(dns_codes) / sizeof(*dns_codes))
+				return -1;
+			part = dns_codes[name[i + 1]];
+			part_len = strlen(part);
+			i += 2;
+		} else {
+			part_len = name[i];
+			if (i + 1 + part_len > len)
+				return -1;
+			part = (const char *) name + i + 1;
+			i += 1 + part_len;
+		}
+		if (part_len == 0)
+			continue;
+		if (n + part_len + 1 >= size)
+			return -1;
+		if (n)
+			out[n++] = '.';
+		memcpy(out + n, part, part_len);
+		n += part_len;
+	}
+	return n;
+}
+
+/* Android's Quick Share, in AirDrop mode, serves on a random port and says so
+ * only here: a Service Response TLV holding the SRV record of its
+ * <instance>._airdrop._tcp.local, in every MIF. Apple devices publish none
+ * and listen on 8770. Anything that is not such a record is ignored, never an
+ * error: it must not cost the frame its other TLVs.
+ *
+ * Value: name length (LE16, counts the type byte), name, type, data length
+ * (LE16), two bytes, then the record: priority, weight, port (BE16), target. */
+int awdl_handle_service_response_tlv(struct awdl_peer *src, const struct buf *val,
+                                     struct awdl_state *state __attribute__((unused))) {
+	static const char service[] = "._airdrop._tcp.local";
+	const uint8_t *name, *srv;
+	uint16_t name_len, data_len, port;
+	uint8_t type;
+	char text[HOST_NAME_LENGTH_MAX + sizeof(service)];
+	int n;
+
+	READ_LE16(val, 0, &name_len);
+	if (name_len < 1)
+		return RX_IGNORE;
+	READ_BYTES(val, 2, &name, name_len - 1);
+	READ_U8(val, 1 + name_len, &type);
+	READ_LE16(val, 2 + name_len, &data_len);
+	READ_BYTES(val, 6 + name_len, &srv, data_len);
+	if (type != 33 /* SRV */ || data_len < 6)
+		return RX_IGNORE;
+	n = dns_name(name, name_len - 1, text, sizeof(text));
+	if (n <= (int) strlen(service) || memcmp(text + n - strlen(service), service, strlen(service)))
+		return RX_IGNORE;
+	port = (uint16_t) (srv[4] << 8 | srv[5]);
+	if (port && port != src->airdrop_port) {
+		src->airdrop_port = port;
+		log_info("peer %s airdrop port %u", ether_ntoa(&src->addr), port);
+	}
+	return RX_OK;
+wire_error:
+	return RX_IGNORE;
+}
