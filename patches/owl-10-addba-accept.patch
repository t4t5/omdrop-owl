 }
 
+int awdl_init_addba_response(uint8_t *buf, const struct awdl_state *state,
+                             struct ieee80211_state *ieee80211_state) {
+	uint8_t *ptr = buf;
+	uint16_t size = (state->addba.params >> 6) & 0x3ff;
+	uint16_t params;
+
+	if (size == 0 || size > 64)
+		size = 64;
+	/* bit 0 A-MSDU supported (no), bit 1 immediate Block Ack, bits 2-5 TID,
+	 * bits 6-15 buffer size */
+	params = (uint16_t) ((state->addba.params & 0x003c) | 0x0002 | (size << 6));
+
+	ptr += ieee80211_init_radiotap_header(ptr);
+	ptr += ieee80211_init_awdl_action_hdr(ptr, &state->self_address, &state->addba.peer, ieee80211_state);
+	*ptr++ = IEEE80211_CATEGORY_BACK;
+	*ptr++ = IEEE80211_ACTION_ADDBA_RESP;
+	*ptr++ = state->addba.token;
+	*ptr++ = 0; /* status: success */
+	*ptr++ = 0;
+	*ptr++ = (uint8_t) (params & 0xff);
+	*ptr++ = (uint8_t) (params >> 8);
+	*ptr++ = (uint8_t) (state->addba.timeout & 0xff);
+	*ptr++ = (uint8_t) (state->addba.timeout >> 8);
+	if (ieee80211_state->fcs)
+		ptr += ieee80211_add_fcs(buf, ptr);
+
+	return ptr - buf;
+}
