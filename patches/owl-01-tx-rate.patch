+struct ieee80211_tx_rate awdl_data_tx_rate = { .legacy = 12, .mcs = -1, .sgi = 0 };
+
+static const struct ieee80211_tx_rate legacy_12 = { .legacy = 12, .mcs = -1, .sgi = 0 };
+
+/* "12" (legacy Mbit/s), "mcs7" (HT MCS, 20 MHz) or "mcs7-sgi". */
+int ieee80211_parse_tx_rate(const char *s, struct ieee80211_tx_rate *rate) {
+	static const int legacy_ok[] = { 6, 9, 12, 18, 24, 36, 48, 54 };
+	char *end;
+	long v;
+
+	rate->sgi = 0;
+	if (!strncmp(s, "mcs", 3)) {
+		v = strtol(s + 3, &end, 10);
+		if (end == s + 3 || v < 0 || v > 15)
+			return -1;
+		if (!strcmp(end, "-sgi"))
+			rate->sgi = 1;
+		else if (*end)
+			return -1;
+		rate->mcs = (int) v;
+		rate->legacy = 0;
+		return 0;
+	}
+	v = strtol(s, &end, 10);
+	if (end == s || *end)
+		return -1;
+	for (size_t i = 0; i < sizeof(legacy_ok) / sizeof(legacy_ok[0]); i++) {
+		if (v == legacy_ok[i]) {
+			rate->legacy = (int) v;
+			rate->mcs = -1;
+			return 0;
+		}
+	}
+	return -1;
+}
+
+int ieee80211_format_tx_rate(char *buf, size_t len, const struct ieee80211_tx_rate *rate) {
+	if (rate->mcs < 0)
+		return snprintf(buf, len, "legacy %d Mbit/s", rate->legacy);
+	return snprintf(buf, len, "HT MCS %d, 20 MHz%s", rate->mcs, rate->sgi ? ", short GI" : "");
+}
+
 int ieee80211_init_radiotap_header(uint8_t *buf) {
+	return ieee80211_init_radiotap_header_rate(buf, &legacy_12);
+}
+
+int ieee80211_init_radiotap_header_rate(uint8_t *buf, const struct ieee80211_tx_rate *rate) {
 	/*
 	 * TX radiotap headers and mac80211
 	 * https://www.kernel.org/doc/Documentation/networking/mac80211-injection.txt
+	 *
+	 * mac80211 turns a RATE or MCS field into a fixed rate for the frame
+	 * (IEEE80211_TX_CTRL_RATE_INJECT). Whether the driver and firmware then
+	 * use it is up to them; only throughput tells.
 	 */
 	struct ieee80211_radiotap_header *hdr = (struct ieee80211_radiotap_header *) buf;
 	uint8_t *ptr = buf + sizeof(struct ieee80211_radiotap_header);
@@ -306,11 +358,16 @@ int ieee80211_init_radiotap_header(uint8_t *buf) {
 	hdr->it_version = 0;
 	hdr->it_pad = 0;
 
-	/* TODO Adjust PHY parameters based on receiver capabilities */
-
-	present |= ieee80211_radiotap_type_to_mask(IEEE80211_RADIOTAP_RATE);
-	*ptr = htole16(ieee80211_radiotap_rate_to_val(12));
-	ptr += sizeof(uint8_t);
+	if (rate->mcs < 0) {
+		present |= ieee80211_radiotap_type_to_mask(IEEE80211_RADIOTAP_RATE);
+		*ptr++ = (uint8_t) ieee80211_radiotap_rate_to_val(rate->legacy);
+	} else {
+		/* known, flags, mcs; byte-aligned, so no padding needed after RATE-less header */
+		present |= ieee80211_radiotap_type_to_mask(IEEE80211_RADIOTAP_MCS);
+		*ptr++ = IEEE80211_RADIOTAP_MCS_HAVE_BW | IEEE80211_RADIOTAP_MCS_HAVE_MCS | IEEE80211_RADIOTAP_MCS_HAVE_GI;
+		*ptr++ = IEEE80211_RADIOTAP_MCS_BW_20 | (rate->sgi ? IEEE80211_RADIOTAP_MCS_SGI : 0);
+		*ptr++ = (uint8_t) rate->mcs;
+	}
 
 	hdr->it_len = htole16((uint16_t) (ptr - buf));
 	hdr->it_present = htole32(present);
@@ -389,7 +446,7 @@ int awdl_init_full_data_frame(uint8_t *buf, const struct ether_addr *src, const
                               struct awdl_state *state, struct ieee80211_state *ieee80211_state) {
 	uint8_t *ptr = buf;
 
-	ptr += ieee80211_init_radiotap_header(ptr);
+	ptr += ieee80211_init_radiotap_header_rate(ptr, &awdl_data_tx_rate);
 	ptr += ieee80211_init_awdl_data_hdr(ptr, src, dst, ieee80211_state);
 	ptr += llc_init_awdl_hdr(ptr);
